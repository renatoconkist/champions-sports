<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Theme/theme.uss?fileID=7433441132597879392&amp;guid=e882c81082ad640d895c30fc242e9a86&amp;type=3#theme"/>
    <ui:VisualElement name="register-root" class="cs-screen-root login-root" style="flex-direction: column; padding: 0; background-color: rgb(28, 59, 37);">
        <ui:VisualElement name="bg-image" class="login-bg"/>
        <ui:VisualElement name="bg-overlay" class="login-bg-overlay"/>
        <ui:VisualElement class="login-spacer"/>
        <ui:ScrollView name="scroll-panel" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" class="auth-scroll-panel">
            <ui:VisualElement name="register-panel" class="cs-panel-login">
                <ui:Button name="back-button" text="" tooltip="" class="cs-button-back" style="background-color: rgba(255, 255, 255, 0); border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; background-image: url(&quot;project://database/Assets/Art/UISprites/X.png?fileID=2800000&amp;guid=1a4991c61bcbf473e921a92595543c0f&amp;type=3#X&quot;); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
                <ui:VisualElement name="icon-image" class="auth-icon-small" style="background-image: url(&quot;project://database/Assets/Art/UISprites/logo.png?fileID=2800000&amp;guid=22b58393a4495486bb0d1d7da0251ea7&amp;type=3#logo&quot;); background-color: rgba(255, 255, 255, 0); border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; width: 200px; height: 200px;"/>
                <ui:Label name="title" text="Criar Conta" class="auth-panel-title" style="margin-bottom: 8px;">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:2ceec474979474c7b853c0924ca72fab" entry="Id(1525669889)"/>
                    </Bindings>
                </ui:Label>
                <ui:Label name="subtitle" text="Preencha seus dados para começar." class="auth-panel-subtitle" style="margin-bottom: 24px;">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:2ceec474979474c7b853c0924ca72fab" entry="Id(1525669890)"/>
                    </Bindings>
                </ui:Label>
                <ui:VisualElement name="form" class="login-form">
                    <ui:TextField name="first-name-field" label="" placeholder="Nome" placeholder-text="Nome" binding-path="FirstName" class="cs-input-login" style="margin-bottom: 10px;">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="placeholderText" table="GUID:2ceec474979474c7b853c0924ca72fab" entry="Id(1525669891)"/>
                        </Bindings>
                    </ui:TextField>
                    <ui:TextField name="last-name-field" label="" placeholder="Sobrenome" placeholder-text="Sobrenome" binding-path="LastName" class="cs-input-login" style="margin-bottom: 10px;">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="placeholderText" table="GUID:2ceec474979474c7b853c0924ca72fab" entry="Id(1525669892)"/>
                        </Bindings>
                    </ui:TextField>
                    <ui:TextField name="email-field" label="" placeholder="E-mail" placeholder-text="Email" binding-path="Email" keyboard-type="EmailAddress" class="cs-input-login" style="margin-bottom: 10px;">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="placeholderText" table="GUID:8837daf99efd1458eba2a86583af9536" entry="Id(13564696846336)"/>
                        </Bindings>
                    </ui:TextField>
                    <ui:TextField name="password-field" label="" placeholder="Senha" placeholder-text="Password" binding-path="Password" is-password-field="true" password="true" class="cs-input-login" style="margin-bottom: 10px;">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="placeholderText" table="GUID:8837daf99efd1458eba2a86583af9536" entry="Id(13801465307136)"/>
                        </Bindings>
                    </ui:TextField>
                    <ui:TextField name="confirm-pass-field" label="" placeholder="Confirmar senha" placeholder-text="ConfirmPassword" binding-path="ConfirmPassword" is-password-field="true" password="true" class="cs-input-login" style="margin-bottom: 16px;">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="placeholderText" table="GUID:2ceec474979474c7b853c0924ca72fab" entry="Id(1525669895)"/>
                        </Bindings>
                    </ui:TextField>
                    <ui:Label name="error-label" binding-path="ErrorMessage" class="cs-label-error" style="min-height: 18px; margin-bottom: 8px;"/>
                    <ui:Button name="register-button" text="CRIAR CONTA" class="cs-button-primary login-btn">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:2ceec474979474c7b853c0924ca72fab" entry="Id(1525669900)"/>
                        </Bindings>
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>
        <ui:VisualElement class="login-spacer" style="max-height: 60px;"/>
    </ui:VisualElement>
</ui:UXML>
