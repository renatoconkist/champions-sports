<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <Style src="../Theme/theme.uss" />
    <!--
        Onboarding – Step 2: Escolha de posições
        Controller: PositionsController.cs
        Player selects 1–3 positions on the football field map.
    -->
    <ui:VisualElement name="positions-root" class="cs-screen-root"
                      style="padding-top: 24px; flex-grow: 1;">

        <!-- Header -->
        <ui:Label text="Qual é a sua posição? ⚽"
                  class="cs-section-title"
                  style="-unity-text-align: middle-center; margin-bottom: 8px;" />
        <ui:Label text="Escolha até 3 posições"
                  class="cs-label-secondary"
                  style="-unity-text-align: middle-center; margin-bottom: 24px;" />

        <!-- Football field schematic -->
        <ui:VisualElement name="field-container"
                          style="background-color: rgb(100, 226, 133);
                                 border-radius: 20px;
                                 padding: 16px; margin-bottom: 20px; align-items: center;">

            <!-- Atacantes -->
            <ui:VisualElement name="row-ata"
                              style="flex-direction: row; justify-content: center;
                                     margin-bottom: 8px;">
                <ui:Button name="pos-ponta-esq" text="PDE"
                           class="cs-scope-btn" style="margin-right: 8px;" />
                <ui:Button name="pos-centroavante" text="CA"
                           class="cs-scope-btn" style="margin-right: 8px;" />
                <ui:Button name="pos-ponta-dir" text="PDD"
                           class="cs-scope-btn" />
            </ui:VisualElement>

            <!-- Meia-atacante -->
            <ui:VisualElement name="row-meia-ata"
                              style="flex-direction: row; justify-content: center;
                                     margin-bottom: 8px;">
                <ui:Button name="pos-meia-ata" text="MEI-ATA"
                           class="cs-scope-btn" />
            </ui:VisualElement>

            <!-- Meias / Volante -->
            <ui:VisualElement name="row-meio"
                              style="flex-direction: row; justify-content: center;
                                     margin-bottom: 8px;">
                <ui:Button name="pos-meia-esq" text="ME"
                           class="cs-scope-btn" style="margin-right: 8px;" />
                <ui:Button name="pos-volante" text="VOL"
                           class="cs-scope-btn" style="margin-right: 8px;" />
                <ui:Button name="pos-meia-dir" text="MD"
                           class="cs-scope-btn" />
            </ui:VisualElement>

            <!-- Defensores -->
            <ui:VisualElement name="row-def"
                              style="flex-direction: row; justify-content: center;
                                     margin-bottom: 8px;">
                <ui:Button name="pos-lat-esq" text="LE"
                           class="cs-scope-btn" style="margin-right: 8px;" />
                <ui:Button name="pos-zagueiro" text="ZAG"
                           class="cs-scope-btn" style="margin-right: 8px;" />
                <ui:Button name="pos-lat-dir" text="LD"
                           class="cs-scope-btn" />
            </ui:VisualElement>

            <!-- Goleiro -->
            <ui:VisualElement name="row-gk"
                              style="flex-direction: row; justify-content: center;">
                <ui:Button name="pos-goleiro" text="GOL"
                           class="cs-scope-btn" />
            </ui:VisualElement>

        </ui:VisualElement>

        <!-- Selection state label -->
        <ui:Label name="selection-label" text="Nenhuma posição selecionada"
                  class="cs-label-secondary"
                  style="-unity-text-align: middle-center;
                         margin-bottom: 20px; min-height: 18px;" />

        <!-- Confirm -->
        <ui:Button name="confirm-button" text="Confirmar e entrar"
                   class="cs-button-primary" />

    </ui:VisualElement>
</ui:UXML>
