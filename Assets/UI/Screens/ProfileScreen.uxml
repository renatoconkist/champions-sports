<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <Style src="../Theme/theme.uss" />
    <!--
        Profile Screen (Main → Perfil tab)
        data-source: ProfileViewModel
        Controller:  ProfileController.cs
        Locale keys: PROFILE_*
    -->
    <ui:VisualElement name="profile-root" class="cs-screen-root"
                      style="padding-top: 16px; background-color: rgb(236, 243, 254);">

        <!-- Header card: avatar + nome + nível + XP -->
        <ui:VisualElement name="header-card" class="cs-card"
                          style="margin-bottom: 16px; align-items: center;">

            <ui:VisualElement name="avatar-ring" class="cs-avatar"
                              style="width: 80px; height: 80px; border-width: 3px; margin-bottom: 12px;">
                <ui:Label text="👤" style="font-size: 32px;" />
            </ui:VisualElement>

            <ui:Label name="display-name-label"
                      binding-path="DisplayName"
                      class="cs-section-title"
                      style="-unity-text-align: middle-center; margin-bottom: 4px;" />

            <!-- Chip de nível -->
            <ui:VisualElement name="level-chip"
                              style="flex-direction: row; align-items: center;
                                     background-color: rgb(236, 243, 254);
                                     border-radius: 999px;
                                     padding-left: 12px; padding-right: 12px;
                                     padding-top: 4px; padding-bottom: 4px;
                                     margin-bottom: 12px;">
                <ui:Label text="Nível " class="cs-label-secondary" />
                <ui:Label name="level-label"
                          binding-path="Level"
                          style="font-size: 14px; color: rgb(100, 226, 133);
                                 -unity-font-definition: url('../../Fonts/Inter/Inter-Bold.ttf');" />
            </ui:VisualElement>

            <!-- Barra de XP -->
            <ui:ProgressBar name="xp-bar"
                            binding-path="XPProgress"
                            class="cs-progress-bar"
                            style="width: 100%; height: 8px; border-radius: 999px; margin-bottom: 6px;" />

            <ui:VisualElement style="flex-direction: row; justify-content: space-between; width: 100%;">
                <ui:Label name="xp-label" class="cs-label-caption" />
                <ui:Label name="coins-label"
                          style="font-size: 12px; color: rgb(236, 185, 89);
                                 -unity-font-definition: url('../../Fonts/Inter/Inter-Bold.ttf');" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Stats row -->
        <ui:VisualElement name="stats-row"
                          style="flex-direction: row; margin-bottom: 16px;">

            <ui:VisualElement name="stat-xp" class="cs-card"
                              style="flex-grow: 1; align-items: center; margin-right: 8px;">
                <ui:Label text="⭐" style="font-size: 22px; margin-bottom: 4px;" />
                <ui:Label name="stat-xp-value"
                          binding-path="XP"
                          class="cs-section-title"
                          style="margin-bottom: 0;" />
                <ui:Label text="XP Total" class="cs-label-caption" />
            </ui:VisualElement>

            <ui:VisualElement name="stat-coins" class="cs-card"
                              style="flex-grow: 1; align-items: center; margin-left: 8px;">
                <ui:Label text="🪙" style="font-size: 22px; margin-bottom: 4px;" />
                <ui:Label name="stat-coins-value"
                          binding-path="Coins"
                          style="font-size: 18px; color: rgb(236, 185, 89);
                                 -unity-font-definition: url('../../Fonts/Inter/Inter-Bold.ttf');" />
                <ui:Label text="Moedas" class="cs-label-caption" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Card de posições -->
        <ui:VisualElement name="positions-card" class="cs-card" style="margin-bottom: 16px;">
            <ui:Label text="Minhas posições" class="cs-section-title" />
            <ui:Label name="positions-label" class="cs-label-secondary" />
        </ui:VisualElement>

        <!-- Editar perfil -->
        <ui:Button name="edit-profile-button" text="Editar Perfil"
                   class="cs-button-ghost" style="margin-bottom: 12px;" />

        <!-- Sair -->
        <ui:Button name="logout-button" text="Sair"
                   class="cs-button-danger" />

    </ui:VisualElement>
</ui:UXML>
