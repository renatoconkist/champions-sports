        <ui:Instance template="ContentList" name="content-list" style="margin-left: 0; margin-right: 0; margin-bottom: 12px; flex-shrink: 0;"/>
        <ui:VisualElement name="progress-card" class="cs-card" style="margin-bottom: 16px;">
            <ui:Label name="progress-title" text="Treinos esta semana" class="cs-label-secondary" style="margin-bottom: 8px;"/>
            <ui:ProgressBar name="weekly-bar" binding-path="WeeklyProgress" class="cs-progress-bar" style="height: 10px; border-top-left-radius: 999px; border-top-right-radius: 999px; border-bottom-left-radius: 999px; border-bottom-right-radius: 999px; margin-bottom: 6px;"/>
            <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                <ui:Label name="progress-count" class="cs-label-secondary" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Inter/Inter-Bold.ttf?fileID=12800000&amp;guid=32afd0b82579649bf8d5917abfaff7a9&amp;type=3#Inter-Bold&quot;); color: rgb(13, 27, 42);"/>
                <ui:Label name="progress-goal" class="cs-label-secondary"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:ScrollView>
    <ui:Instance template="HeaderComponent" name="header" style="margin-bottom: 0; flex-shrink: 0; text-shadow: 0 0 0 rgb(0, 0, 0); position: absolute; width: 100%;"/>
    <ui:Instance template="TabBar" name="tabbar" style="flex-shrink: 0; margin-bottom: 16px; align-self: center; position: absolute; bottom: 0;"/>
