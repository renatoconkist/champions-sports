        <ui:ScrollView name="reels-list-scroll" scroll-direction="Horizontal" horizontal-scrollbar-visibility="Hidden" vertical-scrollbar-visibility="Hidden" touch-scroll-type="Elastic" mode="Horizontal" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" style="flex-shrink: 0; margin-left: 0; margin-right: 0; margin-bottom: 12px; padding-left: 8px; padding-right: 8px;">
            <ui:VisualElement name="reels-list-row" class="reels-list-row" style="padding-left: 0; padding-right: 0; padding-bottom: 0; padding-top: 0; margin-right: 0;">
