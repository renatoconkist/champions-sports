<UXML xmlns="UnityEngine.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <VisualElement name="background" class="progress-bar" style="background-color: rgb(26, 26, 26); height: 10px; padding-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0;">
        <VisualElement name="fill" class="progress-bar" style="background-color: rgb(83, 219, 65); flex-shrink: 0; flex-grow: 1; width: 100%; margin-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; flex-direction: row; flex-wrap: nowrap; align-items: auto; max-width: 100%;"/>
    </VisualElement>
</UXML>
