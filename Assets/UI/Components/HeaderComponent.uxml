<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Template name="ProgressBar" src="project://database/Assets/UI/Components/ProgressBar.uxml?fileID=9197481963319205126&amp;guid=996a5e302749e465a923374c5f612e29&amp;type=3#ProgressBar"/>
    <Style src="project://database/Assets/UI/Theme/theme.uss?fileID=7433441132597879392&amp;guid=e882c81082ad640d895c30fc242e9a86&amp;type=3#theme"/>
    <ui:VisualElement name="header-root" style="flex-direction: row; align-items: flex-end; padding-top: 16px; padding-bottom: 16px; background-color: rgb(255, 255, 255); text-shadow: 0 -2px 4px rgb(0, 0, 0); padding-left: 16px; padding-right: 16px; flex-shrink: 0; height: 96px; justify-content: space-around; align-content: stretch; flex-grow: 1;">
        <ui:VisualElement name="DashboardHeading" enabled="true" style="flex-grow: 1; display: flex; height: 64px;">
            <ui:VisualElement name="avatar-profile" style="flex-grow: 1; flex-direction: row-reverse; margin-right: 16px;">
                <ui:VisualElement name="ProfileInfo" enabled="false" style="flex-grow: 1; margin-left: -16px; justify-content: center; align-self: stretch; opacity: 1; overflow: visible;">
                    <ui:Label text="Título" name="profile-name" style="margin-left: 24px; text-shadow: 0 0 0 rgb(0, 0, 0); -unity-font-style: bold; font-size: 18px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Inter/Inter-Bold.ttf?fileID=12800000&amp;guid=32afd0b82579649bf8d5917abfaff7a9&amp;type=3#Inter-Bold&quot;);"/>
                    <ui:Instance template="ProgressBar" name="progressbar-xp" style="text-shadow: 0 0 0 rgb(0, 0, 0);"/>
                </ui:VisualElement>
                <ui:VisualElement name="avatar-thumb" class="cs-avatar" style="width: 64px; height: 64px; margin-right: 0; flex-shrink: 0; background-color: rgb(255, 255, 255); background-image: url(&quot;project://database/Assets/Art/UISprites/boy.png?fileID=21300000&amp;guid=e250a0477fbf3487db173d499db930a0&amp;type=3#boy&quot;); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(236, 243, 254); border-right-color: rgb(236, 243, 254); border-top-color: rgb(236, 243, 254); border-bottom-color: rgb(236, 243, 254);"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="ContentHeading" style="flex-grow: 1; flex-direction: row; align-self: flex-end; align-items: center; display: none;">
            <ui:VisualElement name="BackButton" style="flex-grow: 0; width: 40px; height: 32px; background-image: url(&quot;project://database/Assets/Art/UISprites/arrow-right2.png?fileID=2800000&amp;guid=e27fb1c003df0409284a7f024a0fa41f&amp;type=3#arrow-right2&quot;); -unity-background-image-tint-color: rgb(48, 48, 48); scale: -1 1;"/>
            <ui:Label name="label" binding-path="GreetingName" text="TÍTULO" class="cs-section-title" style="flex-grow: 1; margin-bottom: 0; text-shadow: 0 0 0 rgb(0, 0, 0); flex-shrink: 1; flex-direction: row; align-self: center; -unity-text-align: upper-center; -unity-font-style: bold; font-size: 27px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="Actions" class="cs-chip-coin" style="align-self: auto; align-items: auto; margin-top: 0; margin-bottom: 0; align-content: flex-end; padding-bottom: 8px; padding-top: 8px; background-color: rgba(236, 243, 254, 0); flex-direction: row-reverse; justify-content: flex-end; bottom: 8px;">
            <ui:VisualElement name="bt-menu" style="flex-grow: 1; width: 34px; height: 26px; background-image: url(&quot;project://database/Assets/Art/UISprites/Icon-menu.png?fileID=21300000&amp;guid=dc597543dc07c418b951602758c7a968&amp;type=3#Icon-menu&quot;); -unity-background-image-tint-color: rgb(46, 46, 46); aspect-ratio: 1.433416; margin-bottom: auto; margin-top: auto; margin-left: 8px; margin-right: 8px;"/>
            <ui:VisualElement name="bt-notification" style="flex-grow: 1; width: 28px; height: 32px; background-image: url(&quot;project://database/Assets/Art/UISprites/Icon-notification.png?fileID=21300000&amp;guid=0a321ab3e00e747aeb676cef057ca1f9&amp;type=3#Icon-notification&quot;); -unity-background-image-tint-color: rgb(46, 46, 46); aspect-ratio: 0.8845324; margin-bottom: auto; margin-top: auto; margin-left: 8px; margin-right: 8px; align-items: flex-end; justify-content: flex-end;">
                <ui:VisualElement name="reddot" class="reddot"/>
            </ui:VisualElement>
            <ui:VisualElement name="bt-chat" style="flex-grow: 1; width: 28px; height: 32px; background-image: url(&quot;project://database/Assets/Art/UISprites/Icon-chat.png?fileID=21300000&amp;guid=56d723e91aa3940949cec426b864288f&amp;type=3#Icon-chat&quot;); -unity-background-image-tint-color: rgb(46, 46, 46); aspect-ratio: 0.8845324; margin-bottom: auto; margin-top: auto; margin-left: 8px; margin-right: 8px; align-items: flex-end; justify-content: flex-end;">
                <ui:VisualElement name="reddot" class="reddot"/>
            </ui:VisualElement>
            <ui:VisualElement name="bt-menu" style="flex-grow: 1; width: 24px; height: 24px; background-image: url(&quot;project://database/Assets/Art/UISprites/Coin.png?fileID=21300000&amp;guid=d95288dbb99324685bf2bc24b8f94624&amp;type=3#Coin&quot;); -unity-background-image-tint-color: rgb(255, 255, 255); margin-bottom: auto; margin-top: auto; margin-left: 8px; margin-right: 8px; background-color: rgb(255, 255, 255);">
                <ui:Label text="9999" name="coins" style="align-items: auto; align-self: flex-start; padding-left: 0; margin-left: -2px; flex-shrink: 1; flex-grow: 0; width: 0; flex-direction: column-reverse; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Antonio/Antonio-Variable.ttf?fileID=12800000&amp;guid=e15befcfc08dc4ab38cbe21399fd3cfa&amp;type=3#Antonio-Variable&quot;); color: rgb(204, 156, 16); -unity-text-outline-color: rgb(115, 66, 29); -unity-text-outline-width: 0; -unity-font-style: bold; font-size: 20px; text-overflow: ellipsis; white-space: nowrap; -unity-text-align: upper-right; left: 0%; top: 0%; justify-content: flex-start; align-content: flex-end; margin-right: 0; right: auto; bottom: auto; height: 0; margin-bottom: 0; margin-top: -12px; padding-top: 0; padding-right: 0; padding-bottom: 0;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
